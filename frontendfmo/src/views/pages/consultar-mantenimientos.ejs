<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
    <title>Calendario de Mantenimientos | FMO</title>
    <style>
        :root {
            --fmo-red: #d6291c;
            --fmo-orange: #fa812f;
            --fmo-red-dark: #dd0303;
        }

        /* --- ESTILOS DEL CALENDARIO ANUAL --- */
        .calendario-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .mes-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            padding: 15px;
            border-top: 4px solid var(--fmo-red);
        }

        .mes-titulo {
            text-align: center;
            font-weight: bold;
            color: var(--fmo-red-dark);
            text-transform: uppercase;
            margin-bottom: 10px;
            font-size: 1.1rem;
        }

        .dias-semana {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
            font-weight: bold;
            font-size: 0.8rem;
            color: #6c757d;
            margin-bottom: 5px;
        }

        .dias-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
        }

        .dia-celda {
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.2s;
            color: #333;
        }

        .dia-celda:hover {
            background-color: #f8f9fa;
            transform: scale(1.1);
        }

        .dia-vacio {
            pointer-events: none;
        }

        /* --- EL CÍRCULO NARANJA --- */
        .dia-mantenimiento {
            background-color: var(--fmo-orange);
            color: white;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(250, 129, 47, 0.5);
        }

        .dia-mantenimiento:hover {
            background-color: var(--fmo-red);
            color: white;
            transform: scale(1.15);
        }

        /* --- ESTILOS DE TABLAS Y MODALES --- */
        .table-custom thead {
            background: linear-gradient(135deg, var(--fmo-red-dark), var(--fmo-orange));
            color: white;
        }
        .readonly-field {
            background-color: #f8f9fa !important;
            border: 1px solid #e9ecef;
            font-weight: 500;
            color: #495057;
        }
        .section-label {
            font-size: 0.85rem;
            font-weight: bold;
            color: #666;
            text-transform: uppercase;
            border-bottom: 2px solid var(--fmo-orange);
            margin-bottom: 15px;
            display: inline-block;
            padding-bottom: 3px;
        }

        /* Galería */
        .galeria-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px; padding: 15px; }
        .foto-galeria { width: 100%; height: 150px; object-fit: cover; border-radius: 8px; border: 2px solid #eee; cursor: zoom-in; transition: transform 0.2s;}
        .foto-galeria:hover { transform: scale(1.05); border-color: var(--fmo-orange); }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('../partials/sidebar') %>

        <div id="content" class="w-100 bg-light p-3 fade-in" style="overflow-y: auto;">
            <div class="container-fluid">
                
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 bg-white p-3 rounded-4 shadow-sm border-start border-4 border-danger">
                    <div>
                        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-calendar3 me-2" style="color: var(--fmo-red);"></i>Calendario de Mantenimientos</h4>
                        <small class="text-muted">Visualización anual de los equipos intervenidos</small>
                    </div>
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                        
                        <button class="btn btn-outline-success fw-bold shadow-sm rounded-pill px-3" onclick="exportarCSV()">
                            <i class="bi bi-filetype-csv me-1"></i> Exportar Año
                        </button>

                        <div class="d-flex align-items-center">
                            <label for="anioSelector" class="fw-bold text-muted me-2 mb-0">Año:</label>
                            <select id="anioSelector" class="form-select form-select-lg fw-bold text-primary shadow-sm" style="width: 120px; cursor: pointer;">
                                </select>
                        </div>
                    </div>
                </div>

                <div id="calendarioAnual" class="calendario-grid pb-4">
                    </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="modalListaDia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, var(--fmo-red-dark), var(--fmo-orange));">
                    <h5 class="modal-title fw-bold"><i class="bi bi-list-check me-2"></i>Mantenimientos del Día: <span id="tituloDiaModal"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3 bg-light" id="contenedorLotesDia" style="max-height: 80vh; overflow-y: auto;">
                    
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modalDetalles" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header text-white" style="background: var(--fmo-red-dark);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-clipboard-data me-2"></i>Reporte Técnico</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <span class="section-label">Datos de la Intervención</span>
                            <div class="mb-2"><small class="text-muted fw-bold d-block">Analista Responsable</small><div class="p-2 rounded-2 readonly-field" id="detAnalista"></div></div>
                            <div class="mb-2"><small class="text-muted fw-bold d-block">Gerencia</small><div class="p-2 rounded-2 readonly-field" id="detGerencia"></div></div>
                            <div class="mb-2"><small class="text-muted fw-bold d-block">Departamento</small><div class="p-2 rounded-2 readonly-field" id="detDepto"></div></div>
                            <div class="mb-2"><small class="text-muted fw-bold d-block">Usuario Asignado</small><div class="p-2 rounded-2 readonly-field"><span id="detUsuario"></span> <span class="badge bg-secondary ms-1" id="detFicha"></span></div></div>
                        </div>
                        <div class="col-md-6">
                            <span class="section-label">Especificaciones del Equipo</span>
                            <div class="row g-2">
                                <div class="col-6 mb-2"><small class="text-muted fw-bold d-block">FMO / Serial</small><div class="p-2 rounded-2 readonly-field fw-bold text-primary" id="detFmo"></div></div>
                                <div class="col-6 mb-2"><small class="text-muted fw-bold d-block">Tipo</small><div class="p-2 rounded-2 readonly-field" id="detTipo"></div></div>
                                <div class="col-6 mb-2"><small class="text-muted fw-bold d-block">Marca</small><div class="p-2 rounded-2 readonly-field" id="detMarca"></div></div>
                                <div class="col-6 mb-2"><small class="text-muted fw-bold d-block">Modelo</small><div class="p-2 rounded-2 readonly-field" id="detModelo"></div></div>
                                <div class="col-12 mb-2"><small class="text-muted fw-bold d-block">Sistema Operativo</small><div class="p-2 rounded-2 readonly-field" id="detSo"></div></div>
                                <div class="col-12 mb-2"><small class="text-muted fw-bold d-block">Observaciones</small><div class="p-2 rounded-2 readonly-field" style="min-height: 80px;" id="detObs"></div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalGaleria" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-images me-2"></i>Evidencia Fotográfica</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0 bg-light">
                    <div class="galeria-grid" id="contenedorGaleria"></div>
                </div>
            </div>
        </div>
    </div>


    <%- include('../partials/modal') %>
    <script src="/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/js/utils/api.js"></script>
    <script src="/js/scripts/consultarMantenimientos.js"></script>
</body>
</html>