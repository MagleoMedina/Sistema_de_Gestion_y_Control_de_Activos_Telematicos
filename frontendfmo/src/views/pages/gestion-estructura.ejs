<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
    <title>Estructura Organizativa | FMO</title>
    <style>
        :root {
            --fmo-red: #d6291c;
            --fmo-orange: #fa812f;
        }

        .list-group-item.active {
            background: linear-gradient(135deg, var(--fmo-red), var(--fmo-orange));
            border-color: var(--fmo-red);
            color: white !important;
        }

        .list-group-item {
            cursor: pointer;
            transition: all 0.2s;
        }

        .list-group-item:hover:not(.active) {
            background-color: #fff5f5;
        }

        .action-btn {
            opacity: 0.5;
            transition: opacity 0.2s;
        }
        .list-group-item:hover .action-btn {
            opacity: 1;
        }
        .list-group-item.active .action-btn {
            opacity: 1;
            color: white !important;
        }
        
        /* Panel vacío de departamentos */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 300px;
            color: #999;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('../partials/sidebar') %>

        <div id="content" class="w-100 bg-light p-3 fade-in" style="overflow-y: auto;">
            <div class="container-fluid" style="max-width: 1200px;">
                
                <div class="mb-4">
                    <h4 class="fw-bold m-0 text-dark"><i class="bi bi-diagram-3-fill me-2" style="color: var(--fmo-red);"></i>Estructura Organizativa</h4>
                    <small class="text-muted">Gestión de Gerencias y Departamentos</small>
                </div>

                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h6 class="fw-bold text-uppercase" style="color: var(--fmo-red);">1. Gerencias</h6>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="input-group mb-3 shadow-sm">
                                    <input type="text" id="inputNuevaGerencia" class="form-control" placeholder="Nombre de la nueva gerencia...">
                                    <button class="btn text-white" style="background: var(--fmo-red);" onclick="crearGerencia()">
                                        <i class="bi bi-plus-lg"></i> Agregar
                                    </button>
                                </div>
                                
                                <div class="list-group list-group-flush flex-grow-1 overflow-auto" id="listaGerencias" style="max-height: 500px; border-top: 1px solid #eee;">
                                    <div class="text-center py-4 text-muted small">Cargando gerencias...</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <h6 class="fw-bold text-uppercase" style="color: var(--fmo-orange);">2. Departamentos Asignados</h6>
                                <p class="small text-muted mb-0" id="lblGerenciaSeleccionada">Seleccione una gerencia en el panel izquierdo.</p>
                            </div>
                            <div class="card-body d-flex flex-column">
                                
                                <div id="panelDepartamentos" class="d-none">
                                    <div class="input-group mb-3 shadow-sm">
                                        <input type="text" id="inputNuevoDepto" class="form-control" placeholder="Nombre del nuevo departamento...">
                                        <button class="btn text-white" style="background: var(--fmo-orange);" onclick="crearDepartamento()">
                                            <i class="bi bi-plus-lg"></i> Agregar
                                        </button>
                                    </div>

                                    <div class="list-group list-group-flush flex-grow-1 overflow-auto" id="listaDepartamentos" style="max-height: 500px; border-top: 1px solid #eee;">
                                        </div>
                                </div>

                                <div id="panelVacio" class="empty-state">
                                    <i class="bi bi-building fs-1 mb-2"></i>
                                    <h5>Sin Selección</h5>
                                    <p class="small">Haga clic en una Gerencia para gestionar sus Departamentos.</p>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header text-white" style="background: var(--fmo-red);">
                    <h5 class="modal-title fw-bold" id="tituloModalEditar"><i class="bi bi-pencil-square me-2"></i>Editar</h5>
                    <button type="button\" class="btn-close btn-close-white\" data-bs-dismiss=\"modal\"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <input type="hidden" id="editId">
                    <input type="hidden" id="editTipo"> <label class="form-label small fw-bold text-muted">Nombre Actualizado</label>
                    <input type="text" class="form-control" id="editNombre" required>
                </div>
                <div class="modal-footer bg-white">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn text-white" style="background: var(--fmo-red);" onclick="guardarEdicion()">
                        <i class="bi bi-save-fill me-1"></i> Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminarEstructura" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white\" data-bs-dismiss=\"modal\"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <i class="bi bi-trash3 text-danger mb-3 d-block" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold" id="lblPreguntaEliminar">¿Está seguro?</h5>
                    <p class="text-muted small" id="lblDetalleEliminar"></p>
                    
                    <input type="hidden" id="deleteId">
                    <input type="hidden" id="deleteTipo">
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger px-4" onclick="ejecutarEliminacion()"><i class="bi bi-trash-fill me-2"></i>Sí, Eliminar</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/modal') %>

    <script src="/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/js/utils/html2pdf.bundle.min.js"></script>
    <script src="/js/utils/api.js"></script> 
    <script src="/js/scripts/gestionEstructura.js"></script>
</body>
</html>