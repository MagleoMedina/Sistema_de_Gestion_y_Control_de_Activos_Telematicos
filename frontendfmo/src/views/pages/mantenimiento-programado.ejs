<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/head') %>
    <title>Programar Mantenimiento | FMO</title>
    <style>
        :root {
            --fmo-red: #d6291c;
            --fmo-orange: #fa812f;
            --fmo-red-dark: #dd0303;
        }

        .card-custom {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            background: white;
            margin-bottom: 25px;
        }

        .card-header-custom {
            background: linear-gradient(135deg, var(--fmo-red), var(--fmo-orange));
            color: white;
            border-radius: 12px 12px 0 0 !important;
            padding: 15px 20px;
            font-weight: bold;
        }

        .table-custom thead {
            background-color: #f8f9fa;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        
        .table-custom tbody tr:hover {
            background-color: #fffdf9;
        }

        .badge-pendiente {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
            font-weight: 600;
            padding: 0.4em 0.8em;
        }

        .btn-programar {
            background: linear-gradient(135deg, var(--fmo-red), var(--fmo-orange));
            color: white;
            border: none;
            font-weight: bold;
            transition: transform 0.2s;
        }
        .btn-programar:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 4px 10px rgba(214, 41, 28, 0.3);
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <%- include('../partials/sidebar') %>

        <div id="content" class="w-100 bg-light p-3 fade-in" style="overflow-y: auto;">
            <div class="container-fluid max-w-1200">
                
                <div class="mb-4">
                    <h4 class="fw-bold m-0 text-dark"><i class="bi bi-calendar-plus me-2" style="color: var(--fmo-red);"></i>Programación de Mantenimientos</h4>
                    <small class="text-muted">Planifique y visualice las próximas intervenciones por gerencia</small>
                </div>

                <div class="card-custom">
                    <div class="card-header-custom">
                        <i class="bi bi-plus-circle me-1"></i> Nueva Programación
                    </div>
                    <div class="card-body p-4">
                        <form id="formProgramacion" onsubmit="event.preventDefault(); guardarProgramacion();">
                            <div class="row g-4 align-items-end">
                                <div class="col-md-4 col-12">
                                    <label class="form-label small fw-bold text-muted mb-1">Gerencia a Intervenir <span class="text-danger">*</span></label>
                                    <select class="form-select" id="progGerencia" required>
                                        <option value="" disabled selected>Cargando gerencias...</option>
                                    </select>
                                </div>
                                <div class="col-md-3 col-12">
                                    <label class="form-label small fw-bold text-muted mb-1">Fecha Programada <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="progFecha" required>
                                </div>
                                <div class="col-md-3 col-12">
                                    <label class="form-label small fw-bold text-muted mb-1">Analista Asignado</label>
                                    <input type="text" class="form-control bg-light" id="progAnalista">
                                </div>
                                <div class="col-md-2 col-12">
                                    <button type="submit" class="btn btn-programar w-100 py-2 rounded-3">
                                        Agendar
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card-custom border-top border-4 border-warning">
                    <div class="card-body p-0">
                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white rounded-top-3">
                            <h6 class="m-0 fw-bold text-dark"><i class="bi bi-clock-history text-warning me-2"></i>Mantenimientos Pendientes</h6>
                            <button class="btn btn-sm btn-light border shadow-sm" onclick="cargarPendientes()" title="Actualizar lista">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-custom align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center" width="5%">#</th>
                                        <th width="30%">Gerencia Programada</th>
                                        <th width="15%">Fecha</th>
                                        <th width="25%">Analista Responsable</th>
                                        <th class="text-center" width="10%">Estado</th>
                                        <th class="text-center" width="15%">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tablaPendientes">
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <div class="spinner-border spinner-border-sm text-danger me-2"></div>Cargando pendientes...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarProg" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header text-white" style="background: var(--fmo-red-dark);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Programación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <form id="formEditarProg" onsubmit="event.preventDefault(); guardarEdicion();">
                        <input type="hidden" id="editProgId">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Gerencia</label>
                            <select class="form-select" id="editProgGerencia" required></select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Fecha Programada</label>
                            <input type="date" class="form-control" id="editProgFecha" required>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted">Analista</label>
                            <input type="text" class="form-control bg-light" id="editProgAnalista" required>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm"><i class="bi bi-save me-1"></i>Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalConfirmDeleteProg" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 text-center bg-light">
                    <i class="bi bi-trash3-fill text-danger mb-3 d-block" style="font-size: 4rem;"></i>
                    <h5 class="fw-bold">¿Desea anular esta programación?</h5>
                    <p class="text-muted">Se eliminará la fecha reservada para el mantenimiento. Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pb-4 bg-light">
                    <button type="button" class="btn btn-secondary px-4 rounded-pill shadow-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill shadow-sm" id="btnEjecutarDeleteProg">
                        <i class="bi bi-trash-fill me-1"></i> Sí, Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/modal') %>
    <script src="/js/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/js/utils/api.js"></script>
    <script src="/js/scripts/mantenimientoProgramado.js"></script>
</body>
</html>