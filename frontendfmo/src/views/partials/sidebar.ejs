<style>
    /* --- PALETA FMO (Definición Local para el Sidebar) --- */
    :root {
        --sidebar-bg: #212529;
        --sidebar-width: 260px;
        --sidebar-collapsed-width: 70px;
        --fmo-red: #d6291c;
        --fmo-orange: #fa812f;
        --fmo-gradient: linear-gradient(135deg, #dd0303 0%, #fa812f 100%);
    }

    /* --- 1. LAYOUT GLOBAL --- */
    .wrapper {
        display: flex;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

    /* --- 2. SIDEBAR (Base y Desktop) --- */
    #sidebar {
        min-width: var(--sidebar-width);
        max-width: var(--sidebar-width);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        flex-shrink: 0;
        z-index: 1050; /* Z-index alto para mobile */
        overflow-x: hidden;
        overflow-y: auto; /* Permite el scroll vertical si hay muchos menús */
        background-color: var(--sidebar-bg) !important;
        position: relative;
        border-right: 1px solid rgba(255,255,255,0.05);
        
        /* Custom Scrollbar para Firefox */
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.15) var(--sidebar-bg);
    }

    /* --- CUSTOM SCROLLBAR (Chrome, Edge, Safari) --- */
    #sidebar::-webkit-scrollbar {
        width: 6px; /* Scrollbar más delgada y elegante */
    }
    #sidebar::-webkit-scrollbar-track {
        background: var(--sidebar-bg); /* Mismo fondo oscuro del sidebar */
    }
    #sidebar::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.15); /* Gris semitransparente */
        border-radius: 10px;
    }
    #sidebar::-webkit-scrollbar-thumb:hover {
        background-color: var(--fmo-orange); /* Se ilumina en naranja al pasar el mouse */
    }

    .no-transition { transition: none !important; }

    /* Estado Colapsado en Desktop */
    @media (min-width: 769px) {
        #sidebar.collapsed {
            min-width: var(--sidebar-collapsed-width);
            max-width: var(--sidebar-collapsed-width);
        }
        #sidebar.collapsed .link-text,
        #sidebar.collapsed .dropdown-toggle::after,
        #sidebar.collapsed .sidebar-title span {
            opacity: 0;
            pointer-events: none;
            display: none;
        }
        #sidebar.collapsed .nav-link, 
        #sidebar.collapsed .dropdown-toggle {
            justify-content: center !important;
            padding-left: 0;
            padding-right: 0;
        }
        #sidebar.collapsed .icon-container { margin-right: 0 !important; }
        #sidebar.collapsed .collapse { display: none !important; }
        
        /* Dropdown Flotante para submenús cuando está colapsado */
        #sidebar.collapsed .dropdown-menu {
            position: fixed !important;
            left: 75px !important;
            bottom: 20px !important;
            top: auto !important;
            width: auto !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255,255,255,0.1);
            background: #2c3034;
        }
    }

    /* --- RESPONSIVIDAD (MOBILE) --- */
    @media (max-width: 768px) {
        #sidebar {
            position: fixed;
            height: 100vh;
            left: -260px; /* Escondido por defecto a la izquierda */
            box-shadow: 5px 0 15px rgba(0,0,0,0.5);
        }
        
        /* Esta clase se la agregaremos con JS cuando toquen el botón en mobile */
        #sidebar.mobile-open {
            left: 0;
        }
        
        /* Overlay oscuro detrás del menú en mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1040;
        }
        .sidebar-overlay.active {
            display: block;
        }
    }

    /* --- ESTILOS DE NAVEGACIÓN FMO --- */
    .icon-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-width: 30px;
        width: 30px;
        margin-right: 0.5rem;
        font-size: 1.2rem;
        color: var(--fmo-orange);
        transition: color 0.3s;
    }

    /* Control de desbordamiento de texto */
    .link-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
        vertical-align: middle;
    }

    .nav-pills .nav-link {
        color: #e0e0e0;
        margin-bottom: 4px;
        transition: all 0.2s ease;
        border-radius: 8px;
        overflow: hidden;
    }

    .nav-pills .nav-link:hover {
        background-color: rgba(214, 41, 28, 0.15);
        color: white;
        transform: translateX(3px);
    }
    .nav-pills .nav-link:hover .icon-container { color: #fff; }

    .nav-pills .nav-link.active {
        background: var(--fmo-gradient) !important;
        color: white !important;
        box-shadow: 0 4px 15px rgba(221, 3, 3, 0.4);
    }
    .nav-pills .nav-link.active .icon-container { color: white !important; }

    .sidebar-title i { color: var(--fmo-red); }
    
    .toggle-btn {
        background: none;
        border: none; color: white;
        font-size: 1.5rem; cursor: pointer; padding: 0 10px;
        transition: transform 0.3s; line-height: 1;
    }
    .toggle-btn:hover { color: var(--fmo-orange); }

    .admin-only { display: none !important; }
    
    #content {
        flex-grow: 1;
        width: auto !important;
        overflow-y: auto;
        height: 100vh;
        transition: all 0.3s ease;
    }

    .submenu-link {
        padding-left: 3rem !important;
        font-size: 0.9em;
        background-color: rgba(0, 0, 0, 0.3);
        border-left: 3px solid transparent;
    }
    .submenu-link.active {
        background-color: rgba(214, 41, 28, 0.2) !important;
        border-left-color: var(--fmo-orange) !important;
        background-image: none !important;
        box-shadow: none !important;
    }

    .bi { vertical-align: text-bottom; }
</style>

